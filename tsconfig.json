{
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "target": "ES2018",
    "module": "ESNext",
    "jsx": "react",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["chrome"]
  },
  "include": ["src", ".storybook"]
}
